# --- Core ---
NODE_ENV=development
APP_URL=http://localhost:3000
AUTH_SECRET=replace-me-with-openssl-rand-base64-32
AUTH_TRUST_HOST=true

# --- Database ---
DATABASE_URL=postgresql://marvidesk:marvidesk@localhost:5432/marvidesk?schema=public

# --- Redis (BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- SSO providers ---
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0

# --- Outbound email (SMTP / Postmark / SES) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="MarviDesk <support@example.com>"
# Domain used for per-ticket inbound reply tokens, e.g. reply+<token>@inbound.example.com
INBOUND_EMAIL_DOMAIN=inbound.example.com

# --- Inbound email webhook auth ---
INBOUND_WEBHOOK_SECRET=replace-me

# --- S3 / MinIO (attachments) ---
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=marvidesk
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
